# Copy to .env for local runs (never commit the real .env).
# PostgreSQL connection string. Required -- the app has no SQLite fallback.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Dify workflow API key, used by the "Open chatbot" report-generation feature.
# A shared demo key is in the User Manual if you don't have your own.
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Azure Application Insights connection string. Leave unset to disable telemetry.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
